# 复制为 .env 后按需修改。所有值均可被 config.toml 覆盖。
# 服务监听地址
CODEWHALE_SERVER__HOST=127.0.0.1
CODEWHALE_SERVER__PORT=8787

# DeepSeek V4-Flash 配置
CODEWHALE_DEEPSEEK__API_KEY=sk-your-deepseek-key
CODEWHALE_DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
CODEWHALE_DEEPSEEK__MODEL=deepseek-chat

# 推理默认参数
CODEWHALE_INFERENCE__REASONING_EFFORT=medium
CODEWHALE_INFERENCE__CACHE_ENABLED=true
CODEWHALE_INFERENCE__CONTEXT_LENGTH=20

# 日志级别
RUST_LOG=info,codewhale_server=debug
