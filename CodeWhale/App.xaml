<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CodeWhale.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!-- ============== 属性元素（必须集中在内容属性 Items 之前） ============== -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 深色主题（Codex Dark） -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppBgColor">#1E1E1E</Color>
                    <Color x:Key="AppSidebarBgColor">#252526</Color>
                    <Color x:Key="AppLayerColor">#2D2D2D</Color>
                    <Color x:Key="AppLayerAltColor">#333333</Color>
                    <Color x:Key="AppCardColor">#262626</Color>
                    <Color x:Key="AppTextPrimaryColor">#D4D4D4</Color>
                    <Color x:Key="AppTextSecondaryColor">#9D9D9D</Color>
                    <Color x:Key="AppTextTertiaryColor">#6B6B6B</Color>
                    <Color x:Key="AppDividerColor">#3C3C3C</Color>
                    <Color x:Key="AppBorderDefaultColor">#3C3C3C</Color>
                    <Color x:Key="AppAccentColor">#4EC9B0</Color>
                    <Color x:Key="AppAccentSoftColor">#1E3A1E</Color>
                    <Color x:Key="AppCodeAddedColor">#4EC9B0</Color>
                    <Color x:Key="AppCodeRemovedColor">#F48771</Color>
                    <Color x:Key="AppCodeHeaderColor">#569CD6</Color>
                    <Color x:Key="AppCodeKeywordColor">#569CD6</Color>
                    <Color x:Key="AppCodeStringColor">#CE9178</Color>
                    <Color x:Key="AppCodeCommentColor">#6A9955</Color>
                    <Color x:Key="AppCodeNumberColor">#B5CEA8</Color>
                    <Color x:Key="AppCodeDefaultColor">#D4D4D4</Color>
                    <Color x:Key="AppUserBubbleBgColor">#2D2D2D</Color>
                    <Color x:Key="AppAssistantBubbleBgColor">#1E1E1E</Color>
                    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
                    <SolidColorBrush x:Key="AppSidebarBgBrush" Color="{StaticResource AppSidebarBgColor}"/>
                    <SolidColorBrush x:Key="AppLayerBrush" Color="{StaticResource AppLayerColor}"/>
                    <SolidColorBrush x:Key="AppLayerAltBrush" Color="{StaticResource AppLayerAltColor}"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCardColor}"/>
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}"/>
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource AppTextTertiaryColor}"/>
                    <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}"/>
                    <SolidColorBrush x:Key="AppBorderDefaultBrush" Color="{StaticResource AppBorderDefaultColor}"/>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}"/>
                    <SolidColorBrush x:Key="AppCodeAddedBrush" Color="{StaticResource AppCodeAddedColor}"/>
                    <SolidColorBrush x:Key="AppCodeRemovedBrush" Color="{StaticResource AppCodeRemovedColor}"/>
                    <SolidColorBrush x:Key="AppCodeHeaderBrush" Color="{StaticResource AppCodeHeaderColor}"/>
                    <SolidColorBrush x:Key="AppUserBubbleBgBrush" Color="{StaticResource AppUserBubbleBgColor}"/>
                    <SolidColorBrush x:Key="AppAssistantBubbleBgBrush" Color="{StaticResource AppAssistantBubbleBgColor}"/>
                </ResourceDictionary>

                <!-- 浅色主题（Codex Light） -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppBgColor">#FFFFFF</Color>
                    <Color x:Key="AppSidebarBgColor">#F3F3F3</Color>
                    <Color x:Key="AppLayerColor">#F9F9F9</Color>
                    <Color x:Key="AppLayerAltColor">#EAEAEA</Color>
                    <Color x:Key="AppCardColor">#FFFFFF</Color>
                    <Color x:Key="AppTextPrimaryColor">#1E1E1E</Color>
                    <Color x:Key="AppTextSecondaryColor">#5A5A5A</Color>
                    <Color x:Key="AppTextTertiaryColor">#8A8A8A</Color>
                    <Color x:Key="AppDividerColor">#E0E0E0</Color>
                    <Color x:Key="AppBorderDefaultColor">#D0D0D0</Color>
                    <Color x:Key="AppAccentColor">#0E7C66</Color>
                    <Color x:Key="AppAccentSoftColor">#E6F4F0</Color>
                    <Color x:Key="AppCodeAddedColor">#2E7D32</Color>
                    <Color x:Key="AppCodeRemovedColor">#C62828</Color>
                    <Color x:Key="AppCodeHeaderColor">#0277BD</Color>
                    <Color x:Key="AppCodeKeywordColor">#0277BD</Color>
                    <Color x:Key="AppCodeStringColor">#A85A00</Color>
                    <Color x:Key="AppCodeCommentColor">#6A9955</Color>
                    <Color x:Key="AppCodeNumberColor">#5B5BD6</Color>
                    <Color x:Key="AppCodeDefaultColor">#1E1E1E</Color>
                    <Color x:Key="AppUserBubbleBgColor">#EAEAEA</Color>
                    <Color x:Key="AppAssistantBubbleBgColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
                    <SolidColorBrush x:Key="AppSidebarBgBrush" Color="{StaticResource AppSidebarBgColor}"/>
                    <SolidColorBrush x:Key="AppLayerBrush" Color="{StaticResource AppLayerColor}"/>
                    <SolidColorBrush x:Key="AppLayerAltBrush" Color="{StaticResource AppLayerAltColor}"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCardColor}"/>
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}"/>
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource AppTextTertiaryColor}"/>
                    <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}"/>
                    <SolidColorBrush x:Key="AppBorderDefaultBrush" Color="{StaticResource AppBorderDefaultColor}"/>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}"/>
                    <SolidColorBrush x:Key="AppCodeAddedBrush" Color="{StaticResource AppCodeAddedColor}"/>
                    <SolidColorBrush x:Key="AppCodeRemovedBrush" Color="{StaticResource AppCodeRemovedColor}"/>
                    <SolidColorBrush x:Key="AppCodeHeaderBrush" Color="{StaticResource AppCodeHeaderColor}"/>
                    <SolidColorBrush x:Key="AppUserBubbleBgBrush" Color="{StaticResource AppUserBubbleBgColor}"/>
                    <SolidColorBrush x:Key="AppAssistantBubbleBgBrush" Color="{StaticResource AppAssistantBubbleBgColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============== 内容属性 Items（所有普通资源项集中在此，不可被打断） ============== -->

            <!-- 字体族 -->
            <x:String x:Key="AppUIFontFamily">Segoe UI Variable, Segoe UI</x:String>
            <x:String x:Key="AppCodeFontFamily">Cascadia Code, Consolas, Courier New</x:String>

            <!-- 字号尺度 -->
            <x:Double x:Key="AppFontSizeCaption">11</x:Double>
            <x:Double x:Key="AppFontSizeBody">13</x:Double>
            <x:Double x:Key="AppFontSizeBodyStrong">13</x:Double>
            <x:Double x:Key="AppFontSizeSubtitle">14</x:Double>
            <x:Double x:Key="AppFontSizeTitle">16</x:Double>
            <x:Double x:Key="AppFontSizeCode">13</x:Double>

            <!-- 间距尺度 -->
            <Thickness x:Key="AppSpacingXXS">2,2,2,2</Thickness>
            <Thickness x:Key="AppSpacingXS">4,4,4,4</Thickness>
            <Thickness x:Key="AppSpacingS">8,8,8,8</Thickness>
            <Thickness x:Key="AppSpacingM">12,12,12,12</Thickness>
            <Thickness x:Key="AppSpacingL">16,16,16,16</Thickness>
            <Thickness x:Key="AppSpacingXL">24,24,24,24</Thickness>

            <!-- 圆角 -->
            <CornerRadius x:Key="AppCornerRadiusS">3</CornerRadius>
            <CornerRadius x:Key="AppCornerRadiusM">5</CornerRadius>
            <CornerRadius x:Key="AppCornerRadiusL">8</CornerRadius>

            <!-- 通用面板 Header -->
            <Style x:Key="AppPanelHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppLayerBrush}"/>
                <Setter Property="Padding" Value="14,10,14,8"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- 通用标题文字 -->
            <Style x:Key="AppPanelTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeSubtitle}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 代码文字 -->
            <Style x:Key="AppCodeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppCodeFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeCode}"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
            </Style>

            <!-- 工具图标按钮 -->
            <Style x:Key="AppIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>

            <!-- 状态点 -->
            <Style x:Key="AppStatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Fill" Value="{ThemeResource AppTextTertiaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
