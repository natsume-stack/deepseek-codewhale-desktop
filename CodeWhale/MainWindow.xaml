<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodeWhale.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodeWhale.Views"
    Closed="MainWindow_Closed">

    <!-- 根容器：标题栏 + 三栏主体，整体由 Mica 渗透；侧栏 Acrylic 在各视图内部声明 -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 自绘标题栏：48px 高，对齐 Codex 桌面端 -->
            <RowDefinition Height="48"/>
            <!-- 主体三栏 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 自绘标题栏 ========== -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="48"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- App 图标 + 名称 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 中部项目名 / 模型标识（拖拽区） -->
                <ColumnDefinition Width="*"/>
                <!-- 系统窗口按钮（最小化/最大化/关闭由系统绘制） -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：Logo + App 名称 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Padding="16,0,0,0"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="CodeWhale"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 中：项目名 + 模型 chip（可拖拽区，SetTitleBar 绑定） -->
            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Padding="12,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleProjectName"
                               Text="未打开项目"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"/>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TitleModelChip"
                                   Text="deepseek-chat"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontFamily="Cascadia Code, Consolas"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 右：窗口控制按钮由系统绘制（ExtendsContentIntoTitleBar + SystemCaptionButtons） -->
            <Border x:Name="TitleBarCaptionButtons"
                    Grid.Column="2"
                    Background="Transparent"/>
        </Grid>

        <!-- ========== 三栏主体 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="220"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="6"/>
                <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左：项目文件树（侧栏 Acrylic 在 FileTreeView 内部声明） -->
            <views:FileTreeView x:Name="FileTree" Grid.Column="0"/>

            <!-- 左分隔条（可拖拽调整左栏宽度，双击折叠） -->
            <Grid x:Name="LeftSplitter"
                  Grid.Column="1"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  DoubleTapped="LeftSplitter_DoubleTapped"
                  ToolTipService.ToolTip="拖拽调整宽度 · 双击折叠">
                <Rectangle Width="1"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource AppDividerBrush}"/>
                <!-- 命中区：8px 宽，便于操作 -->
                <Rectangle Width="8" Fill="Transparent"/>
            </Grid>

            <!-- 中：对话面板 -->
            <views:ChatPanel x:Name="ChatPanelView" Grid.Column="2"/>

            <!-- 右分隔条（可拖拽调整右栏宽度，双击折叠） -->
            <Grid x:Name="RightSplitter"
                  Grid.Column="3"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  DoubleTapped="RightSplitter_DoubleTapped"
                  ToolTipService.ToolTip="拖拽调整宽度 · 双击折叠">
                <Rectangle Width="1"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource AppDividerBrush}"/>
                <Rectangle Width="8" Fill="Transparent"/>
            </Grid>

            <!-- 右：参数控制面板 -->
            <views:ParameterPanel x:Name="ParamsPanel" Grid.Column="4"/>
        </Grid>
    </Grid>
</Window>
