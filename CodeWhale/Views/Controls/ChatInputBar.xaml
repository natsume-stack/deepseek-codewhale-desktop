<UserControl
    x:Class="CodeWhale.Views.Controls.ChatInputBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 输入框：多行、回车发送、Shift+Enter 换行 -->
            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="140"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyDown="InputBox_KeyDown" />

            <!-- 发送按钮 -->
            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Click="SendButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="发送（Enter）"
                    VerticalAlignment="Bottom"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                    <TextBlock Text="发送" />
                </StackPanel>
            </Button>

            <!-- 停止按钮：任务运行时可见 -->
            <Button Grid.Column="2"
                    x:Name="StopButton"
                    Click="StopButton_Click"
                    ToolTipService.ToolTip="停止当前任务"
                    VerticalAlignment="Bottom"
                    Padding="14,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="停止" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
