<UserControl
    x:Class="CodeWhale.Views.Controls.CodeBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource AppLayerAltBrush}"
            BorderBrush="{ThemeResource AppBorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCornerRadiusM}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：文件名 + 语言标签 + 复制按钮 -->
            <Grid Grid.Row="0"
                  Background="{ThemeResource AppLayerBrush}"
                  Padding="12,5"
                  BorderBrush="{ThemeResource AppDividerBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 文件图标 -->
                <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="12"
                          Foreground="{ThemeResource AppTextSecondaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>

                <!-- 文件名（如果设置） -->
                <TextBlock x:Name="FilePathText"
                           Grid.Column="1"
                           Text=""
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="12"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 语言标签 + 复制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AppLayerAltBrush}"
                            CornerRadius="2"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageTag"
                                   Text="text"
                                   FontSize="11"
                                   FontFamily="Cascadia Code, Consolas"
                                   Foreground="{ThemeResource AppAccentBrush}"/>
                    </Border>
                    <Button x:Name="CopyButton"
                            Click="CopyButton_Click"
                            Style="{StaticResource AppIconButtonStyle}"
                            Padding="6,2"
                            ToolTipService.ToolTip="复制代码">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 代码主体：横向滚动，避免长行换行；左侧行号列 -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 行号列 -->
                    <StackPanel x:Name="LineNumbersPanel"
                                Grid.Column="0"
                                Background="{ThemeResource AppLayerAltBrush}"
                                Width="40"/>
                    <!-- 代码文本（由代码后置构建行） -->
                    <StackPanel x:Name="CodeLinesPanel"
                                Grid.Column="1"
                                Padding="12,8,12,10"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
