<UserControl
    x:Class="CodeWhale.Views.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodeWhale.Views.Controls"
    HorizontalContentAlignment="Stretch">

    <!-- 气泡外框：对齐与背景由代码后置按角色设置 -->
    <Border x:Name="Bubble"
            MaxWidth="760"
            HorizontalAlignment="Left"
            CornerRadius="10"
            Padding="14,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <StackPanel x:Name="Root" Spacing="8">

            <!-- 角色头：名称 + 时间 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RoleText"
                           Grid.Column="0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="TimeText"
                           Grid.Column="2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 消息正文（文本段 + 代码块，由代码后置构建） -->
            <StackPanel x:Name="ContentPanel" Spacing="8" />

            <!-- 工具调用日志（由代码后置构建） -->
            <StackPanel x:Name="ToolCallsPanel" Spacing="6" />

            <!-- 代码变更预览（由代码后置构建） -->
            <StackPanel x:Name="DiffsPanel" Spacing="8" />

            <!-- 流式接收指示 -->
            <StackPanel x:Name="StreamingIndicator" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="14" Height="14" IsActive="True" />
                <TextBlock Text="生成中…" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
