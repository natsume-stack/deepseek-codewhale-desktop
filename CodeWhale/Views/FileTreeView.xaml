<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodeWhale.Views.FileTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodeWhale.Models"
    Loaded="FileTreeView_Loaded">

    <UserControl.Resources>
        <!-- 上下文文件列表项模板 -->
        <DataTemplate x:Key="ContextFileTemplate" x:DataType="models:FileNode">
            <Grid Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind FullPath}">
                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="12"/>
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Tag="{x:Bind}"
                        Click="RemoveContext_Click"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="从上下文移除">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 根 Grid：In-app Acrylic 背景，对齐 Codex 侧栏通透磨砂 -->
    <Grid>
        <Grid.Background>
            <AcrylicBrush
                TintColor="{ThemeResource AppSidebarBgColor}"
                TintOpacity="0.55"
                FallbackColor="{ThemeResource AppSidebarBgColor}"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- 顶部 Header：项目名 + 新建按钮 + 打开/刷新 -->
            <RowDefinition Height="Auto"/>
            <!-- 文件树主体 -->
            <RowDefinition Height="*"/>
            <!-- 上下文文件区 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶部 Header ========== -->
        <Border Grid.Row="0" Style="{StaticResource AppPanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 项目名 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" VerticalAlignment="Center"
                              Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="ProjectNameText"
                               Text="未打开项目"
                               Style="{StaticResource AppPanelTitleStyle}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="160"/>
                </StackPanel>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="NewFileButton"
                            Click="NewFile_Click"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTipService.ToolTip="新建文件"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE7C3;" FontSize="13"/>
                    </Button>
                    <Button x:Name="NewFolderButton"
                            Click="NewFolder_Click"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTipService.ToolTip="新建文件夹"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE8DA;" FontSize="13"/>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Click="Refresh_Click"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTipService.ToolTip="刷新目录树"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    </Button>
                    <Button x:Name="OpenFolderButton"
                            Click="OpenFolder_Click"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTipService.ToolTip="选择本地项目根目录">
                        <FontIcon Glyph="&#xE838;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 文件树主体 ========== -->
        <Grid Grid.Row="1">
            <TreeView x:Name="Tree"
                      ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
                      ItemInvoked="Tree_ItemInvoked"
                      Expanding="Tree_Expanding"
                      RightTapped="Tree_RightTapped"
                      SelectionMode="Single"
                      CanReorderItems="False"
                      AllowDrop="False"
                      Padding="4,4,4,8">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileNode">
                        <TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="13"/>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- 空状态提示（卡片化，对齐 Codex 风格） -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Opacity="0.7"
                        Padding="20">
                <FontIcon Glyph="&#xE8B7;" FontSize="36" HorizontalAlignment="Center"
                          Foreground="{ThemeResource AppTextTertiaryBrush}"/>
                <TextBlock Text="尚未打开项目"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                <TextBlock Text="点击右上角图标选择本地文件夹"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ========== 上下文文件区 ========== -->
        <StackPanel Grid.Row="2"
                    Background="{ThemeResource AppLayerBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8"
                    Spacing="4"
                    Visibility="{x:Bind ContextPanelVisibility, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="上下文文件" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" x:Name="ContextCount" Opacity="0.6"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"/>
            </Grid>
            <ListView x:Name="ContextList"
                      ItemsSource="{x:Bind ViewModel.ContextFiles, Mode=OneWay}"
                      ItemTemplate="{StaticResource ContextFileTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      MaxHeight="140">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
